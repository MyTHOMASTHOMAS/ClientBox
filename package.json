{
  "name": "clientsbox",
  "version": "0.1.0",
  "description": "ClientsBox — CLI wrapper for cursor-cli, block execution engine and web canvas",
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-embedded-assets.ts",
    "predev": "npm run build:assets",
    "dev": "vite build --watch --mode development",
    "prebuild": "npm run build:assets",
    "build": "vite build --mode production",
    "start": "node dist/clientsbox.js",
    "pretest": "npm run build:assets",
    "test": "vitest run && npm run test:e2e",
    "pretest:unit": "npm run build:assets",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:test": "vite build --mode test",
    "pretest:e2e": "npm run seed:dev && npm run build:test",
    "test:e2e": "playwright test",
    "pretypecheck": "npm run build:assets",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prequality": "npm run build:assets",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "ci": "npm test && npm run quality",
    "puml:svg": "node scripts/puml-to-svg.js",
    "puml": "node scripts/puml-to-svg.js",
    "bundle:docs": "node scripts/bundle-doc/bundle-raw.js",
    "bundle:raw": "node scripts/bundle-doc/bundle-raw.js",
    "seed:dev": "node scripts/seed-dev.js"
  },
  "keywords": [
    "clientsbox",
    "cursor-cli",
    "orchestration",
    "tdd",
    "workflow"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "plantuml-encoder": "^1.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lru-cache": "^11.5.3",
    "marked": "^18.1.3",
    "preact": "^11.0.1"
  }
}
