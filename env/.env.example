# ClientsBox — Modèle de variables d'environnement (contrat de build, cf. ADR-008)
# Copiez ce fichier sous le nom `.env` et renseignez les valeurs de votre machine.
# Ne mettez jamais de secret ici : les valeurs sont écrites en clair dans le livrable dist/clientsbox.js.

# 1. Chemin absolu du binaire Cursor CLI (Obligatoire — REQ-031, REQ-112, ADR-003)
# Exemple Linux : /home/<utilisateur>/.local/bin/cursor-agent
# Exemple macOS : /Users/<utilisateur>/.local/bin/cursor-agent
CURSOR_CLI_BIN=

# 1b. Chemin absolu du binaire Antigravity CLI (Obligatoire pour adaptateur antigravity — SPEC-ADPT-04, ADR-002)
# Exemple Linux : /home/<utilisateur>/.local/bin/agy
# Exemple macOS : /Users/<utilisateur>/.local/bin/agy
# Exemple Windows : C:\Users\<utilisateur>\AppData\Local\agy\bin\agy.exe
ANTIGRAVITY_CLI_BIN=

# 1c. Timeout d'amorce de session Antigravity en millisecondes (Optionnel — défaut : 15000)
ANTIGRAVITY_PROBE_TIMEOUT_MS=15000

# 1d. Chemin absolu du binaire Codex CLI (Obligatoire pour adaptateur codex-cli — SPEC-ADPT-05, ADR-002)
# Exemple Linux : /usr/local/bin/codex
# Exemple macOS : /usr/local/bin/codex
# Exemple Windows : C:\Users\<utilisateur>\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe
CODEX_CLI_BIN=

# 1e. Timeout d'amorce de session Codex en millisecondes (Optionnel — défaut : 15000)
CODEX_PROBE_TIMEOUT_MS=15000

# 1f. Chemin absolu du binaire Claude CLI (Obligatoire pour adaptateur claude-cli — SPEC-ADPT-06, ADR-002)
# Exemple Linux : /home/<utilisateur>/.npm-global/bin/claude ou /usr/local/bin/claude
# Exemple macOS : /Users/<utilisateur>/.npm-global/bin/claude
# Exemple Windows : C:\Users\<utilisateur>\AppData\Roaming\npm\claude.cmd
CLAUDE_CLI_BIN=

# 1g. Timeout d'amorce de session Claude en millisecondes (Optionnel — défaut : 15000)
CLAUDE_PROBE_TIMEOUT_MS=15000

# 2. Port d'écoute du serveur HTTP local (Optionnel — REQ-002, C-04, défaut : 2974)
PORT=2974

# 3. Interface réseau d'écoute locale exclusive (Optionnel — SPEC-SRV-02, C-11, défaut : 127.0.0.1)
HOST=127.0.0.1

# 4. Répertoire racine des données ClientsBox (Optionnel — SPEC-SRV-01, ADR-005, défaut : .agents)
AGENTS_DIR=.agents

# 4b. Profondeur max d'imbrication CallScenario (Optionnel — REQ-041, défaut : -1 = illimité)
# -1 ou absent = aucune limite ; entier ≥ 0 = plafond d'imbrication
CALL_SCENARIO_MAX_DEPTH=-1

# 5. Mode d'exécution (Optionnel — development / production)
NODE_ENV=development

# 6. Journalisation structurée (Optionnel — true pour désactiver totalement les logs)
LOGS_DISABLED=false
